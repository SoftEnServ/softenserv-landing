# Copia este archivo como .env y cambia las contraseñas
POSTGRES_DB=ses
POSTGRES_USER=ses
POSTGRES_PASSWORD=cambia_esta_clave
WEB_PORT=8080

# Puerto de PostgreSQL en tu PC (5434 para no chocar con otros Postgres en 5432 y 5433)
DB_PORT=5434

# --- Correo de contacto ---
# Los mensajes del formulario llegan al email de contacto de la base de datos (site_settings.contact_email),
# con el asunto "Contacto Comercial Landing Page". MAIL_TO solo se usa si la base no tiene uno.
# Con Gmail: SMTP_USER es tu cuenta y SMTP_PASS una "contraseña de aplicación" (no tu contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=softenserv@gmail.com
SMTP_PASS=
MAIL_TO=softenserv@gmail.com
